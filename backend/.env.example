# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google OAuth Scopes
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/colaboratory

# Google Colab API
COLAB_API_BASE_URL=https://colaboratory.googleapis.com
COLAB_API_VERSION=v1beta
COLAB_OPERATIONS_VERSION=v1

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=

# Google Drive (separate authorization required)
GOOGLE_DRIVE_DATASET_FOLDER_ID=
GOOGLE_DRIVE_CHECKPOINT_FOLDER_ID=
GOOGLE_DRIVE_MODEL_FOLDER_ID=

# HEXA AI Lab Mode & Security
COLAB_INTEGRATION_MODE=MANUAL
GOOGLE_OAUTH_ENABLED=false
PORT=3001
HOST=127.0.0.1
ENCRYPTION_MASTER_KEY=
ADMIN_API_TOKEN=
DASHBOARD_PORT=4173

# Initial Administrator Bootstrap (does not overwrite existing admins)
HEXA_BOOTSTRAP_ADMIN_USERNAME=
HEXA_BOOTSTRAP_ADMIN_PASSWORD=
HEXA_BOOTSTRAP_ADMIN_DISPLAY_NAME=

